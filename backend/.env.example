# ─── NVIDIA NIM API Configuration ──────────────────────────────────────────
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MULTIMODAL_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_DIMS=1024

# ─── Search API Configuration ─────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# ─── MongoDB Database Configuration ───────────────────────────────────────
# Local: mongodb://localhost:27017
# Docker Compose: mongodb://mongodb:27017
MONGODB_URI=mongodb://mongodb:27017
DB_NAME=chatbot

# ─── Redis Cache Configuration ────────────────────────────────────────────
# Local: redis://localhost:6379
# Docker Compose: redis://redis:6379
REDIS_URL=redis://redis:6379

# ─── CORS Configuration (comma-separated origins) ────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Generate a long random secret for production and set Secure=true behind HTTPS.
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=24
